# Versi image
VERSION=6.4.1-64
IMAGE_REPO=ghcr.io/zammad/zammad

POSTGRES_VERSION=17.4-alpine
REDIS_VERSION=7.4.2-alpine
MEMCACHE_VERSION=1.6.37-alpine
ELASTICSEARCH_VERSION=8.17.3

# Database Zammad
POSTGRES_DB=zammad_production
POSTGRES_USER=zammad
POSTGRES_PASS=zammad
POSTGRES_HOST=zammad-postgresql
POSTGRES_PORT=5432
POSTGRESQL_OPTIONS=?pool=50

# Redis
REDIS_URL=redis://zammad-redis:6379

# Backup
BACKUP_DIR=/var/tmp/zammad
BACKUP_TIME=03:00
HOLD_DAYS=10

# Timezone
TZ=Asia/Jakarta

# Nginx port
NGINX_PORT=8080
NGINX_EXPOSE_PORT=8080

# Restart policy
RESTART=always

# pgAdmin
PGADMIN_DEFAULT_EMAIL=agus.supriadi.aria@gmail.com
PGADMIN_DEFAULT_PASSWORD=2390agUS**

# Elasticsearch
ELASTICSEARCH_PASS=zammad
